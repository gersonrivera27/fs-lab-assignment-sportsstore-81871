@inherits LayoutComponentBase
@inject Cart Cart

<div class="bg-dark text-white p-2">
    <div class="container-fluid">
        <div class="row">
            <div class="col navbar-brand">
                <a class="text-white text-decoration-none" href="/">SPORTS STORE</a>
            </div>
            <div class="col-6 navbar-text text-end">
                <AuthorizeView>
                    <Authorized>
                        <span class="me-3">Signed in as @context.User.Identity?.Name</span>
                        <a class="btn btn-sm btn-outline-light me-2" href="/myorders">My Orders</a>
                        <a class="btn btn-sm btn-warning me-3" href="/account/logout">Logout</a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-sm btn-outline-light me-2" href="/account/login">Login</a>
                        <a class="btn btn-sm btn-primary me-3" href="/account/register">Register</a>
                    </NotAuthorized>
                </AuthorizeView>
                <CartSummary />
            </div>
        </div>
    </div>
</div>
<div class="row m-1 p-1">
    <div id="categories" class="col-3">
        <NavMenu />
    </div>
    <div class="col-9">
        @Body
    </div>
</div>
